{
    "name": "jarryd/route-notes",
    "description": "Add human-readable notes to Laravel routes and displays them in the route:list command.",
    "type": "library",
    "keywords": [
        "laravel",
        "routes",
        "artisan",
        "dx",
        "documentation"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Jarryd Hoffman",
            "email": "jarryd.hoffman@windowslive.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "Jarryd\\RouteNotes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jarryd\\RouteNotes\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jarryd\\RouteNotes\\RouteNotesServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
